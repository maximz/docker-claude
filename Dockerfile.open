# cc-open: Full-featured Claude Code base without firewall
# For containers that need unrestricted internet (e.g. search agent)
# The firewalled cc image derives FROM this.
FROM node:20

ARG TZ
ENV TZ="$TZ"

ARG CLAUDE_CODE_VERSION=latest

# Base tools + Python (no firewall packages -- those go in cc)
RUN set -eux; \
    sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list || true; \
    sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources || true; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    wget \
    less \
    git \
    procps \
    sudo \
    fzf \
    zsh \
    man-db \
    unzip \
    gnupg2 \
    gh \
    jq \
    nano \
    vim \
    python3 \
    python3-pip \
    python3-venv \
    python-is-python3; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# Let the node user own a global npm directory
RUN mkdir -p /usr/local/share/npm-global && \
    chown -R node:node /usr/local/share/npm-global

ARG USERNAME=node

# Persist shell history
RUN SNIPPET="export PROMPT_COMMAND='history -a' && export HISTFILE=/commandhistory/.bash_history" \
    && mkdir /commandhistory \
    && touch /commandhistory/.bash_history \
    && chown -R $USERNAME /commandhistory

# Mark as devcontainer-style image (some tools look at this)
ENV DEVCONTAINER=true

# Workspace and Claude config dir
RUN mkdir -p /workspace /home/node/.claude && \
    chown -R node:node /workspace /home/node/.claude

WORKDIR /workspace

# Install git-delta (nice diff viewer)
ARG GIT_DELTA_VERSION=0.18.2
RUN ARCH=$(dpkg --print-architecture) && \
    wget "https://github.com/dandavison/delta/releases/download/${GIT_DELTA_VERSION}/git-delta_${GIT_DELTA_VERSION}_${ARCH}.deb" && \
    dpkg -i "git-delta_${GIT_DELTA_VERSION}_${ARCH}.deb" && \
    rm "git-delta_${GIT_DELTA_VERSION}_${ARCH}.deb"

# Switch to non-root for normal work
USER node

# Node/npm config and defaults
ENV NPM_CONFIG_PREFIX=/usr/local/share/npm-global
ENV PATH=$PATH:/usr/local/share/npm-global/bin
ENV SHELL=/bin/zsh
ENV EDITOR=nano
ENV VISUAL=nano

# Install zsh setup
ARG ZSH_IN_DOCKER_VERSION=1.2.0
RUN sh -c "$(wget -O- https://github.com/deluan/zsh-in-docker/releases/download/v${ZSH_IN_DOCKER_VERSION}/zsh-in-docker.sh)" -- \
    -p git \
    -p fzf \
    -a "source /usr/share/doc/fzf/examples/key-bindings.zsh" \
    -a "source /usr/share/doc/fzf/examples/completion.zsh" \
    -a "export PROMPT_COMMAND='history -a' && export HISTFILE=/commandhistory/.bash_history" \
    -x

# Install Claude Code CLI
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}

# Install agent-browser CLI
RUN npm install -g agent-browser

# Install Chromium for agent-browser.
# Chrome for Testing (agent-browser's bundled browser) lacks ARM64 support,
# so we install system Chromium and pre-launch it with --no-sandbox for Docker.
# agent-browser connects via CDP (--cdp flag) rather than launching Chrome itself,
# because its env-var/config-based arg passing is unreliable in containers.
# A helper script (start-browser.sh) starts Chromium and is called from entrypoints.
USER root
RUN apt-get update && \
    apt-get install -y --no-install-recommends chromium && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
COPY start-browser.sh /usr/local/bin/start-browser.sh
RUN chmod +x /usr/local/bin/start-browser.sh
USER node

# Install uv
USER root
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh

USER node

# === No-MCP hardening ===
# --dangerously-skip-permissions auto-approves tool calls, including first-party
# claude.ai MCP connectors (Linear/Gmail/Asana/Google/...). Those reach
# api.anthropic.com -- the same channel Claude needs -- so the egress firewall and
# settings.json `deny` rules CANNOT block them. The reliable block is removing MCP
# at the CLI, enforced here so it can't be forgotten.
#
# 1) Wrapper shadows the claude binary and always injects an empty MCP config +
#    --strict-mcp-config. /usr/local/bin precedes the npm-global bin in PATH, so
#    this wins; the entrypoint exec's `claude`, which resolves to the wrapper.
# 2) DISABLE_AUTOUPDATER pins claude to the build-time version (update via image
#    rebuild), so an auto-update can't relocate the binary ahead of the wrapper.
# 3) ENABLE_CLAUDEAI_MCP_SERVERS=false is a config-level block of claude.ai
#    connectors (defense-in-depth alongside the CLI wrapper).
ENV DISABLE_AUTOUPDATER=1
ENV ENABLE_CLAUDEAI_MCP_SERVERS=false
USER root
COPY claude-guard.sh /usr/local/bin/claude
RUN chmod +x /usr/local/bin/claude
USER node
